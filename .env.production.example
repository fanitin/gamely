APP_NAME=gamely
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Required when running behind a reverse proxy (nginx, Cloudflare, load balancer).
# Without it Laravel does not see HTTPS: secure session cookies and the HSTS
# header in SecurityHeaders middleware are both gated on $request->isSecure().
# Use "*" only when the proxy is the sole entry point to the container.
TRUSTED_PROXIES=*

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gamely
DB_USERNAME=gamely
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# VITE_* values are inlined at build time, not read at runtime.
# After changing any of them the frontend must be rebuilt (npm run build).
VITE_APP_NAME="${APP_NAME}"
VITE_GA_MEASUREMENT_ID=
VITE_ADSENSE_CLIENT_ID=

IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
IGDB_BASE_URL=https://api.igdb.com/v4
IGDB_RATE_LIMIT_SLEEP_MS=250

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=

TELESCOPE_ENABLED=false
